{% extends 'base.html.twig' %}

{% block title %}Смотрю — Кинотеатр{% endblock %}

{% block body %}
    {% include '_partials/new_seasons.html.twig' with {newSeasons: newSeasons} only %}
    {% include '_partials/new_episodes.html.twig' with {newItems: newItems} only %}

    <div class="catalog-toolbar">
        <h1 class="page-title">★ Смотрю</h1>
    </div>
    {% include '_partials/genre_chips.html.twig' with {
        route: 'app_watching',
        baseParams: {q: q},
        genre: genre,
        allLabel: 'Все жанры'
    } only %}

    {% include '_partials/title_count.html.twig' with {total: total} only %}
    {% if items %}
        <div class="grid">
            {% for item in items %}
                <div class="watching-cell">
                    {% include 'catalog/_card.html.twig' with {item: item} only %}
                    {% include '_partials/watch_progress.html.twig' with {item: item, p: progress[item.id] ?? null} only %}
                </div>
            {% endfor %}
        </div>

        {% include '_partials/pagination.html.twig' with {
            route: 'app_watching',
            baseParams: {q: q ?: null, genre: genre},
            page: page,
            pages: pages
        } only %}
    {% else %}
        <div class="empty">
            {% if q %}
                <h2>Ничего не найдено</h2>
                <p>Попробуйте другой запрос.</p>
            {% else %}
                <h2>Список «Смотрю» пуст</h2>
                <p>Добавляйте тайтлы кнопкой <strong>«+ Смотрю»</strong> на карточке или над плеером.</p>
                <a class="btn btn-primary tv-focus" href="{{ path('app_catalog') }}">В каталог</a>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
