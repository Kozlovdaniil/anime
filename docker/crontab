# Cron-задания кинотеатра. Путь и пользователя подставить под свой сервер.
#
# Установка (от пользователя, у которого есть доступ к docker):
#   crontab /opt/cinema/docker/crontab
# Проверить: crontab -l
#
# Логи: <проект>/var/log/amd-sync.log
PATH=/usr/local/bin:/usr/bin:/bin
SHELL=/bin/bash

# Парсинг обновлений amd.online: дважды в день (06:00 и 18:00), по 10 страниц.
# Свежие серии — первыми (каталог отсортирован по дате редактирования).
0 6,18 * * * /opt/cinema/docker/sync-updates.sh
