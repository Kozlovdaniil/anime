# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=1a949f249683ff46a7ab9a5d894413de
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8081
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Хост — сервис database из docker-compose.yml. Для запуска консоли на хосте
# используйте: docker compose exec app php bin/console ...
DATABASE_URL="postgresql://films:films@database:5432/films?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> kodik api ###
# Заглушка: получите токен на kodikapi.com и подставьте сюда (или в .env.local)
KODIK_API_TOKEN=CHANGE_ME
KODIK_API_BASE_URL=https://kodik-api.com
KODIK_API_PAGE_SIZE=50
###< kodik api ###

###> amedia / amd.online ###
# Парсер сайта amd.online (Animedia) — второй режим, работает без токена.
# Сайт отдаёт 404 без браузерного User-Agent, поэтому UA задан явно.
AMD_ONLINE_BASE_URL=https://amd.online
AMD_ONLINE_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/131.0 Safari/537.36"
AMD_ONLINE_DELAY_MS=250
###< amedia / amd.online ###

###> отдельный инстанс (клон для Kodik) ###
POSTGRES_DB=films
POSTGRES_USER=films
POSTGRES_PASSWORD=films
APP_PORT=8081
